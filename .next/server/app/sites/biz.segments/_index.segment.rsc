2:T4019,{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://weccelerate.co.il/#organization","name":"WeCcelerate","alternateName":["WeCcelerate","We Accelerate","We-Ccelerate","Weccelerate","We-Accelerate","וויסלרייט","ויקלרייט","ווי אקסלרייט","וויסלרייט קידום עסקים","וי-אקסלרייט","ווי סלרייט"],"legalName":"WeCcelerate Ltd.","description":"וויסלרייט היא פלטפורמת האצת הטכנולוגיה המובילה בישראל, התומכת ביזמים בכל המגזרים - מבינה מלאכותית ואפליקציות מובייל ועד IoT ומוצרים פיזיים. השותפות האסטרטגית שלנו עם לאומית שירותי בריאות יוצרת מסלול MedTech בלעדי המציע גישה לדאטה רפואי אנונימי, פיילוטים קליניים והכוונה רגולטורית. בין אם אתם בונים את האפליקציה הפורצת הבאה או מחוללים מהפכה בתחום הבריאות, וויסלרייט מספקת את המומחיות, המשאבים והקשרים להאיץ את הצלחתכם.","url":"https://weccelerate.co.il","logo":{"@type":"ImageObject","@id":"https://weccelerate.co.il/#logo","url":"https://weccelerate.co.il/logo.png","contentUrl":"https://weccelerate.co.il/logo.png","width":512,"height":512,"caption":"WeCcelerate Logo"},"image":{"@type":"ImageObject","url":"https://weccelerate.co.il/og-image.jpg","width":1200,"height":630},"parentOrganization":{"@type":"HealthcareOrganization","@id":"https://www.leumit.co.il/#organization","name":"Leumit Health Services","alternateName":"לאומית שירותי בריאות","description":"One of Israel's four major health funds, providing comprehensive healthcare services to over 700,000 members. Strategic partner for WeCcelerate's MedTech acceleration track.","url":"https://www.leumit.co.il","logo":"https://www.leumit.co.il/images/logo.png","areaServed":{"@type":"Country","name":"Israel","identifier":"IL"}},"foundingDate":"2020","foundingLocation":{"@type":"Place","name":"Tel Aviv, Israel"},"email":"info@weccelerate.co.il","telephone":"+972-3-XXX-XXXX","address":{"@type":"PostalAddress","streetAddress":"Innovation Hub","addressLocality":"Tel Aviv","addressRegion":"Tel Aviv District","postalCode":"6100000","addressCountry":"IL"},"geo":{"@type":"GeoCoordinates","latitude":32.0636,"longitude":34.7721},"areaServed":[{"@type":"Country","name":"Israel","identifier":"IL"},{"@type":"GeoCircle","geoMidpoint":{"@type":"GeoCoordinates","latitude":32.0636,"longitude":34.7721},"geoRadius":"50000","description":"Global reach from Tel Aviv"}],"sameAs":["https://www.linkedin.com/company/weccelerate","https://www.facebook.com/weccelerate","https://twitter.com/weccelerate","https://www.youtube.com/@weccelerate"],"contactPoint":[{"@type":"ContactPoint","contactType":"customer service","telephone":"+972-3-XXX-XXXX","email":"info@weccelerate.co.il","availableLanguage":["Hebrew","English"],"hoursAvailable":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday"],"opens":"09:00","closes":"18:00"}},{"@type":"ContactPoint","contactType":"sales","email":"startups@weccelerate.co.il","availableLanguage":["Hebrew","English"]}],"naics":"541611","isicV4":"7020","knowsAbout":["MedTech Startups","Healthcare Innovation","Digital Health","MVP Development","Startup Acceleration","Medical Device Regulation","FDA Approval Process","Israeli Healthcare System","FinTech","EdTech","FoodTech","AgriTech","PropTech","RetailTech","InsurTech","LegalTech","CleanTech","HealthTech","MedTech","BioTech","Cybersecurity","Enterprise Software","Consumer Apps"],"memberOf":[{"@type":"Organization","name":"Israel Innovation Authority"},{"@type":"Organization","name":"Start-Up Nation Central"}]},{"@type":"WebSite","@id":"https://weccelerate.co.il/#website","name":"WeCcelerate","alternateName":"וויסלרייט","description":"Israel's leading platform for startup acceleration, app development, and tech ventures. Unique MedTech track with Leumit Health Services.","url":"https://weccelerate.co.il","publisher":{"@id":"https://weccelerate.co.il/#organization"},"inLanguage":["he-IL","en"],"potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://weccelerate.co.il/search?q={search_term_string}"},"query-input":"required name=search_term_string"}},{"@type":"WebPage","@id":"https://weccelerate.co.il//#webpage","url":"https://weccelerate.co.il/","name":"WeCcelerate - הפלטפורמה המובילה לסטארטאפים רפואיים","description":"וויסלרייט מאיצה סטארטאפים בכל תחומי הטכנולוגיה - בינה מלאכותית, אפליקציות, IoT, SaaS ומוצרים פיזיים. מסלול ה-MedTech הייחודי שלנו בשיתוף לאומית מספק גישה חסרת תקדים לדאטה רפואי ותיקוף קליני.","isPartOf":{"@id":"https://weccelerate.co.il/#website"},"about":{"@id":"https://weccelerate.co.il/#organization"},"inLanguage":"he-IL","primaryImageOfPage":{"@id":"https://weccelerate.co.il/#logo"},"datePublished":"2024-01-01T00:00:00+02:00","dateModified":"2026-01-08T11:44:17.975Z"},{"@type":"BreadcrumbList","@id":"https://weccelerate.co.il//#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"בית","item":"https://weccelerate.co.il"}]},{"@type":"LocalBusiness","@id":"https://weccelerate.co.il/#localbusiness","name":"WeCcelerate Innovation Hub","image":"https://weccelerate.co.il/og-image.jpg","telephone":"+972-3-XXX-XXXX","email":"info@weccelerate.co.il","address":{"@type":"PostalAddress","streetAddress":"Innovation Hub","addressLocality":"Tel Aviv","addressRegion":"Tel Aviv District","postalCode":"6100000","addressCountry":"IL"},"geo":{"@type":"GeoCoordinates","latitude":32.0636,"longitude":34.7721},"url":"https://weccelerate.co.il","sameAs":["https://www.linkedin.com/company/weccelerate","https://www.facebook.com/weccelerate"],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday"],"opens":"09:00","closes":"18:00"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Friday","opens":"09:00","closes":"14:00"}],"priceRange":"₪₪₪","paymentAccepted":["Credit Card","Bank Transfer"],"currenciesAccepted":"ILS","areaServed":{"@type":"Country","name":"Israel"}},{"@type":"Service","@id":"https://weccelerate.co.il/#services","name":"WeCcelerate Acceleration Program","description":"WeCcelerate accelerates startups across all tech sectors - AI, mobile apps, IoT, SaaS, and physical products. Our exclusive MedTech track with Leumit Health Services provides unmatched access to medical data and clinical validation.","provider":{"@id":"https://weccelerate.co.il/#organization"},"areaServed":{"@type":"Country","name":"Israel"},"audience":{"@type":"Audience","audienceType":"Healthcare Entrepreneurs","geographicArea":{"@type":"Country","name":"Israel"}},"serviceType":"Startup Acceleration","category":"Business Consulting","hasOfferCatalog":{"@type":"OfferCatalog","name":"WeCcelerate Services","itemListElement":[{"@type":"Offer","@id":"https://weccelerate.co.il/#service-full-stack-development","itemOffered":{"@type":"Service","name":"Full-Stack Development","alternateName":"פיתוח פולסטאק","description":"End-to-end development for web and mobile applications. From concept to deployment, we build scalable, production-ready solutions.","category":"Software Development"},"priceSpecification":{"@type":"PriceSpecification","price":"50000","priceCurrency":"ILS"},"position":1},{"@type":"Offer","@id":"https://weccelerate.co.il/#service-mvp-development","itemOffered":{"@type":"Service","name":"MVP Development","alternateName":"פיתוח MVP","description":"Rapid prototyping and minimum viable product development. Validate your idea quickly with a working product that attracts investors.","category":"Product Development"},"priceSpecification":{"@type":"PriceSpecification","price":"35000","priceCurrency":"ILS"},"position":2},{"@type":"Offer","@id":"https://weccelerate.co.il/#service-ai-integration","itemOffered":{"@type":"Service","name":"AI Integration","alternateName":"הטמעת בינה מלאכותית","description":"Integrate cutting-edge AI capabilities into your business. From ChatGPT and LLMs to custom machine learning models.","category":"AI & Machine Learning"},"priceSpecification":{"@type":"PriceSpecification","price":"75000","priceCurrency":"ILS"},"position":3},{"@type":"Offer","@id":"https://weccelerate.co.il/#service-mobile-apps","itemOffered":{"@type":"Service","name":"Mobile App Development","alternateName":"פיתוח אפליקציות מובייל","description":"Native and cross-platform mobile applications for iOS and Android. Beautiful, performant apps that users love.","category":"Mobile Development"},"priceSpecification":{"@type":"PriceSpecification","price":"60000","priceCurrency":"ILS"},"position":4},{"@type":"Offer","@id":"https://weccelerate.co.il/#service-startup-acceleration","itemOffered":{"@type":"Service","name":"Startup Acceleration Program","alternateName":"תוכנית האצת סטארטאפים","description":"Comprehensive acceleration program including mentorship, resources, investor connections, and workspace. Turn your idea into a fundable company.","category":"Business Acceleration"},"priceSpecification":{"@type":"PriceSpecification","price":"0","priceCurrency":"ILS"},"position":5},{"@type":"Offer","@id":"https://weccelerate.co.il/#service-investor-connections","itemOffered":{"@type":"Service","name":"Investor Relations & Fundraising","alternateName":"קשרי משקיעים וגיוס הון","description":"Direct introductions to VCs, angel investors, and strategic partners. Pitch preparation and investor deck creation included.","category":"Business Development"},"priceSpecification":{"@type":"PriceSpecification","price":"0","priceCurrency":"ILS"},"position":6},{"@type":"Offer","@id":"https://weccelerate.co.il/#service-medtech-track","itemOffered":{"@type":"Service","name":"MedTech Track (Leumit Partnership)","alternateName":"מסלול MedTech (בשיתוף לאומית)","description":"Exclusive healthcare innovation track with Leumit Health Services. Access to medical data, clinical pilots, physician consultations, and regulatory guidance.","category":"Healthcare Innovation"},"priceSpecification":{"@type":"PriceSpecification","price":"100000","priceCurrency":"ILS"},"position":7},{"@type":"Offer","@id":"https://weccelerate.co.il/#service-medical-data-access","itemOffered":{"@type":"Service","name":"Medical Data Access","alternateName":"גישה לדאטה רפואי","description":"Secure access to anonymized medical data from Leumit for research, AI training, and clinical validation. IRB-approved processes.","category":"Healthcare Data"},"priceSpecification":{"@type":"PriceSpecification","price":"0","priceCurrency":"ILS"},"position":8},{"@type":"Offer","@id":"https://weccelerate.co.il/#service-regulatory-consulting","itemOffered":{"@type":"Service","name":"Regulatory Consulting","alternateName":"ייעוץ רגולטורי","description":"Expert guidance through FDA, CE, and Israeli MOH regulatory pathways for medical devices and digital health products.","category":"Regulatory Affairs"},"priceSpecification":{"@type":"PriceSpecification","price":"45000","priceCurrency":"ILS"},"position":9}]}},{"@type":"FAQPage","@id":"https://weccelerate.co.il/#faq","mainEntity":[{"@type":"Question","@id":"https://weccelerate.co.il/#faq-1","name":"מה זה וויסלרייט?","acceptedAnswer":{"@type":"Answer","text":"וויסלרייט (WeCcelerate) היא פלטפורמת האצת סטארטאפים ופיתוח מוצרים טכנולוגיים מובילה בישראל. אנו מסייעים ליזמים בכל תחומי הטכנולוגיה - מאפליקציות ובינה מלאכותית ועד IoT ומוצרים פיזיים. יתרון ייחודי שלנו הוא מסלול MedTech בלעדי בשיתוף לאומית שירותי בריאות.","author":{"@id":"https://weccelerate.co.il/#organization"}},"position":1},{"@type":"Question","@id":"https://weccelerate.co.il/#faq-2","name":"איך מקימים סטארטאפ?","acceptedAnswer":{"@type":"Answer","text":"הקמת סטארטאפ מתחילה בזיהוי בעיה אמיתית ופיתוח פתרון. דרך WeCcelerate תקבלו ליווי מקיף: עזרה בגיבוש הרעיון, בניית MVP, חיבור למשקיעים ומנטורינג מיזמים מנוסים. התהליך כולל אפיון מוצר, פיתוח, בדיקות שוק וגיוס הון.","author":{"@id":"https://weccelerate.co.il/#organization"}},"position":2},{"@type":"Question","@id":"https://weccelerate.co.il/#faq-3","name":"כמה עולה לפתח אפליקציה?","acceptedAnswer":{"@type":"Answer","text":"עלות פיתוח אפליקציה תלויה במורכבות ובפיצ'רים. MVP בסיסי יכול לעלות 35,000-50,000 ש\"ח, אפליקציה מלאה 60,000-150,000 ש\"ח, ופרויקטים מורכבים יותר. ב-WeCcelerate אנו מציעים הערכת עלויות חינמית ומסלולי תשלום גמישים.","author":{"@id":"https://weccelerate.co.il/#organization"}},"position":3},{"@type":"Question","@id":"https://weccelerate.co.il/#faq-4","name":"מה היתרון של מסלול MedTech עם לאומית?","acceptedAnswer":{"@type":"Answer","text":"מסלול ה-MedTech בשיתוף לאומית מספק יתרונות בלעדיים: גישה לדאטה רפואי אנונימי של מאות אלפי מבוטחים, אפשרות לפיילוטים קליניים במרפאות, התייעצות עם רופאים ומומחים, הכוונה רגולטורית (FDA, CE) ואמינות מוגברת מול משקיעים.","author":{"@id":"https://weccelerate.co.il/#organization"}},"position":4},{"@type":"Question","@id":"https://weccelerate.co.il/#faq-5","name":"איך מגייסים כסף לסטארטאפ?","acceptedAnswer":{"@type":"Answer","text":"גיוס הון מתחיל בהכנת מצגת משקיעים (Pitch Deck) מקצועית והוכחת התאמת מוצר-שוק. WeCcelerate מחברת אתכם ישירות לקרנות הון סיכון, משקיעי אנג'ל ושותפים אסטרטגיים. אנו מלווים בהכנה לפגישות, משא ומתן ועד לסגירת העסקה.","author":{"@id":"https://weccelerate.co.il/#organization"}},"position":5},{"@type":"Question","@id":"https://weccelerate.co.il/#faq-6","name":"באילו תחומים אתם עובדים?","acceptedAnswer":{"@type":"Answer","text":"אנו עובדים בכל תחומי הטכנולוגיה: בינה מלאכותית, אפליקציות מובייל, SaaS, IoT, פינטק, אדטק, פודטק, ריטיילטק, סייבר ועוד. בנוסף, יש לנו מסלול MedTech ייחודי למיזמים בתחום הבריאות בשיתוף לאומית.","author":{"@id":"https://weccelerate.co.il/#organization"}},"position":6},{"@type":"Question","@id":"https://weccelerate.co.il/#faq-7","name":"מה ההבדל בין אקסלרטור לאינקובטור?","acceptedAnswer":{"@type":"Answer","text":"אינקובטור מתמקד בשלבים המוקדמים ביותר ומספק זמן ומרחב לפיתוח הרעיון. אקסלרטור כמו WeCcelerate מיועד לסטארטאפים עם רעיון מגובש או מוצר ראשוני ומאיץ את הצמיחה באמצעות מנטורינג אינטנסיבי, משאבים, פיתוח וחיבור למשקיעים בתקופה קצרה.","author":{"@id":"https://weccelerate.co.il/#organization"}},"position":7},{"@type":"Question","@id":"https://weccelerate.co.il/#faq-8","name":"כמה זמן לוקח לפתח MVP?","acceptedAnswer":{"@type":"Answer","text":"פיתוח MVP אופייני לוקח 6-12 שבועות, תלוי במורכבות. ב-WeCcelerate אנו משתמשים במתודולוגיות Agile ו-Lean Startup כדי לספק מוצר עובד במהירות, לקבל משוב מהשוק ולשפר באופן מתמיד.","author":{"@id":"https://weccelerate.co.il/#organization"}},"position":8}]}]}0:{"buildId":"JU5y3ZdBzH_4smf7-aU-5","rsc":["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/df63fbc59dd98fec.css","precedence":"next"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/chunks/9ec2ab37823a898b.css","precedence":"next"}]],["$","html",null,{"lang":"he","dir":"rtl","className":"inter_e4ad3ee5-module__JyyZwa__variable heebo_d1381f28-module__AwQe_G__variable","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://fonts.googleapis.com"}],["$","link",null,{"rel":"preconnect","href":"https://fonts.gstatic.com","crossOrigin":"anonymous"}],["$","link",null,{"rel":"preconnect","href":"https://www.google-analytics.com"}],["$","link",null,{"rel":"preconnect","href":"https://www.googletagmanager.com"}],["$","link",null,{"rel":"dns-prefetch","href":"https://www.leumit.co.il"}],["$","link",null,{"rel":"dns-prefetch","href":"https://api.weccelerate.co.il"}],["$","link",null,{"rel":"canonical","href":"https://weccelerate.co.il"}],["$","link",null,{"rel":"alternate","hrefLang":"he-IL","href":"https://weccelerate.co.il"}],["$","link",null,{"rel":"alternate","hrefLang":"en-US","href":"https://weccelerate.co.il/en"}],["$","link",null,{"rel":"alternate","hrefLang":"x-default","href":"https://weccelerate.co.il"}],["$","link",null,{"rel":"alternate","type":"application/rss+xml","title":"WeCcelerate Blog RSS","href":"https://weccelerate.co.il/feed.xml"}],["$","link",null,{"rel":"sitemap","type":"application/xml","href":"https://weccelerate.co.il/sitemap.xml"}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4","$L5