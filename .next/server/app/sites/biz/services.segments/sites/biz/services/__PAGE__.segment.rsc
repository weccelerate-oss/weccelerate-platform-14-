לזהות את הליבה של המוצר ולהתמקד בפיצ'רים שמספיקים להוכיח ערך - לא יותר. הגישה הזו חוסכת זמן וכסף ומאפשרת לקבל פידבק מהר יותר."}]}]]}],["$","details","1",{"className":"group bg-white border border-slate-100 overflow-hidden","itemScope":true,"itemProp":"mainEntity","itemType":"https://schema.org/Question","children":[["$","summary",null,{"className":"flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors","children":[["$","h4",null,{"className":"text-base font-medium text-slate-900 pl-4","itemProp":"name","children":"האם אתם מפתחים את ה-MVP בעצמכם?"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0","aria-hidden":"true","children":[["$","path","qrunsl",{"d":"m6 9 6 6 6-6"}],"$undefined"]}]]}],["$","div",null,{"className":"px-5 pb-5 text-slate-600 leading-relaxed border-t border-slate-100 pt-4","itemScope":true,"itemProp":"acceptedAnswer","itemType":"https://schema.org/Answer","children":["$","p",null,{"itemProp":"text","children":"אנחנו לא בית תוכנה, אבל יש לנו רשת של צוותי פיתוח מומלצים שעבדנו איתם בהצלחה. התפקיד שלנו הוא לעזור לכם להגדיר מה לבנות, לבחור את הטכנולוגיה הנכונה, ולפקח על הפיתוח. זה מבטיח שתקבלו מוצר טוב במחיר הוגן."}]}]]}],["$","details","2",{"className":"group bg-white border border-slate-100 overflow-hidden","itemScope":true,"itemProp":"mainEntity","itemType":"https://schema.org/Question","children":[["$","summary",null,{"className":"flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors","children":[["$","h4",null,{"className":"text-base font-medium text-slate-900 pl-4","itemProp":"name","children":"מה כדאי לכלול ב-MVP ומה לדחות?"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":2