3:T3bf5,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://biz.weccelerate.co.il/services","name":"שירותים עסקיים - WeCcelerate","description":"גיוס הון, פיתוח MVP והתרחבות גלובלית לסטארטאפים","inLanguage":"he"},{"@type":"Service","@id":"https://biz.weccelerate.co.il/services#fundraising","name":"Fundraising Strategy","alternateName":"אסטרטגיית גיוס הון","description":"ליווי מקצועי בכל שלבי גיוס ההון - מבניית המצגת והשווי, דרך פיתוח קשרים עם משקיעים, ועד סגירת הסבב בהצלחה.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il"},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"Business Development","hasOfferCatalog":{"@type":"OfferCatalog","name":"אסטרטגיית גיוס הון","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"בניית Pitch Deck מקצועי"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הערכת שווי (Valuation)"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"גישה לרשת 500+ משקיעים"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הכנה לפגישות משקיעים"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ניהול משא ומתן וסגירה"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Due Diligence support"},"position":6}]}},{"@type":"Service","@id":"https://biz.weccelerate.co.il/services#mvp","name":"MVP Development","alternateName":"פיתוח MVP","description":"ליווי בפיתוח MVP (Minimum Viable Product) - מהגדרת הפיצ'רים הקריטיים, דרך בחירת טכנולוגיה, ועד השקת מוצר שעובד ומאפשר לקבל פידבק מלקוחות.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il"},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"Business Development","hasOfferCatalog":{"@type":"OfferCatalog","name":"פיתוח MVP","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"הגדרת פיצ'רים קריטיים"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ייעוץ ארכיטקטורה טכנית"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"חיבור לצוותי פיתוח מומלצים"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"בניית Roadmap מוצר"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"UX/UI Design review"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ליווי השקה ראשונית"},"position":6}]}},{"@type":"Service","@id":"https://biz.weccelerate.co.il/services#global","name":"Global Expansion","alternateName":"התרחבות גלובלית","description":"ליווי בפתיחת שווקים בינלאומיים - מהבנת השוק המקומי, דרך בניית אסטרטגיה מותאמת, ועד יצירת קשרים עסקיים ומציאת שותפים מקומיים.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il"},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"Business Development","hasOfferCatalog":{"@type":"OfferCatalog","name":"התרחבות גלובלית","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"מחקר שוק בינלאומי"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"אסטרטגיית Go-to-Market"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"חיבור לשותפים מקומיים"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הקמת נוכחות משפטית"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"לוקליזציה ותרבות עסקית"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"מענקים והטבות מס"},"position":6}]}},{"@type":"Service","@id":"https://biz.weccelerate.co.il/services#strategy","name":"Strategic Consulting","alternateName":"ייעוץ אסטרטגי","description":"ייעוץ אסטרטגי מקיף לבניית מודל עסקי מנצח, זיהוי הזדמנויות שוק, והגדרת יתרון תחרותי ברור.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il"},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"Business Development","hasOfferCatalog":{"@type":"OfferCatalog","name":"ייעוץ אסטרטגי","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"בניית Business Model Canvas"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ניתוח שוק ותחרות"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הגדרת Value Proposition"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"אסטרטגיית תמחור"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"תכנון צמיחה"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Pivot consulting"},"position":6}]}},{"@type":"Service","@id":"https://biz.weccelerate.co.il/services#networking","name":"Business Networking","alternateName":"קשרים עסקיים","description":"חיבור לרשת הקשרים העסקית שלנו - מנטורים מנוסים, שותפים אסטרטגיים, לקוחות פוטנציאליים, ויזמים אחרים.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il"},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"Business Development","hasOfferCatalog":{"@type":"OfferCatalog","name":"קשרים עסקיים","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"מנטורים מובילים בתעשייה"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"חיבור ללקוחות Enterprise"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"שותפויות אסטרטגיות"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"קהילת יזמים"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"אירועי Networking"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"מפגשי Demo Day"},"position":6}]}},{"@type":"Service","@id":"https://biz.weccelerate.co.il/services#grants","name":"Grants & Incentives","alternateName":"מענקים והטבות","description":"סיוע בהגשת בקשות למענקים ממשלתיים, הטבות מס לסטארטאפים, ותוכניות תמיכה שונות.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il"},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"Business Development","hasOfferCatalog":{"@type":"OfferCatalog","name":"מענקים והטבות","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"מענקי רשות החדשנות"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הטבות מס R&D"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"תוכניות Horizon Europe"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"מענקים למפעלים מועדפים"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הגשה ומעקב"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"דוחות למענקים"},"position":6}]}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"כמה הון אפשר לגייס דרככם?","acceptedAnswer":{"@type":"Answer","text":"הסטארטאפים שלנו גייסו מ-$500K ועד $15M בסבבים שונים. גובה הגיוס תלוי בשלב החברה, המוצר, והשוק. אנחנו עוזרים לכם להגדיר יעד ריאלי ולבנות אסטרטגיה להגיע אליו. יש לנו ניסיון בגיוסי Pre-Seed, Seed, ו-Series A."}},{"@type":"Question","name":"מה ההבדל בין סבבי Seed ל-Series A?","acceptedAnswer":{"@type":"Answer","text":"סבב Seed (בדרך כלל $500K-$3M) מיועד לחברות בשלב מוקדם - בניית המוצר הראשוני והוכחת ההתאמה לשוק. Series A ($3M-$15M) מגיע כשיש PMF ברור ורוצים להאיץ צמיחה. אנחנו עוזרים להגדיר מה הסבב המתאים לכם ולהכין את החברה בהתאם."}},{"@type":"Question","name":"האם יש לכם קשרים עם קרנות הון סיכון?","acceptedAnswer":{"@type":"Answer","text":"יש לנו קשרים פעילים עם מעל 500 משקיעים, כולל קרנות הון סיכון ישראליות ובינלאומיות (Pitango, JVP, Viola, Sequoia, Insight), משקיעי אנג'ל מובילים, ו-Corporate VCs. אנחנו עושים התאמה בין הסטארטאפ למשקיעים הרלוונטיים ופותחים דלתות."}},{"@type":"Question","name":"כמה זמן לוקח לבנות MVP?","acceptedAnswer":{"@type":"Answer","text":"MVP טיפוסי לוקח בין 2-4 חודשים לפיתוח, תלוי במורכבות. אנחנו עוזרים לכם לזהות את הליבה של המוצר ולהתמקד בפיצ'רים שמספיקים להוכיח ערך - לא יותר. הגישה הזו חוסכת זמן וכסף ומאפשרת לקבל פידבק מהר יותר."}},{"@type":"Question","name":"האם אתם מפתחים את ה-MVP בעצמכם?","acceptedAnswer":{"@type":"Answer","text":"אנחנו לא בית תוכנה, אבל יש לנו רשת של צוותי פיתוח מומלצים שעבדנו איתם בהצלחה. התפקיד שלנו הוא לעזור לכם להגדיר מה לבנות, לבחור את הטכנולוגיה הנכונה, ולפקח על הפיתוח. זה מבטיח שתקבלו מוצר טוב במחיר הוגן."}},{"@type":"Question","name":"מה כדאי לכלול ב-MVP ומה לדחות?","acceptedAnswer":{"@type":"Answer","text":"הכלל הזהב: רק מה שנדרש להוכיח את הערך המרכזי ללקוח. אם אתם בונים אפליקציה לניהול פגישות - אל תבנו עכשיו אינטגרציות מורכבות. התחילו עם הזמנת פגישה, תזכורת, וביטול. נעזור לכם לעשות את החשיבה הזו ולתעדף נכון."}},{"@type":"Question","name":"מאיזה שוק כדאי להתחיל?","acceptedAnswer":{"@type":"Answer","text":"זה תלוי במוצר שלכם. לסטארטאפים רפואיים, ארה\"ב היא לעתים קרובות היעד הראשי בגלל גודל השוק. ל-B2B SaaS, אירופה יכולה להיות נקודת התחלה טובה. לצרכנים, לפעמים שווקים קטנים יותר (הולנד, סינגפור) הם מקום טוב להתנסות לפני ארה\"ב."}},{"@type":"Question","name":"מה נדרש לפתוח חברה בארה\"ב?","acceptedAnswer":{"@type":"Answer","text":"פתיחת חברה בארה\"ב (בדרך כלל Delaware C-Corp) היא תהליך פשוט יחסית שלוקח כמה ימים. הסוגיות האמיתיות הן: מבנה מס נכון, חשבון בנק אמריקאי, ויזה לעבודה אם אתם עוברים לשם. אנחנו מחברים אתכם לעורכי דין ורואי חשבון שמכירים סטארטאפים ישראליים."}},{"@type":"Question","name":"איך מוצאים לקוחות ראשונים בשוק חדש?","acceptedAnswer":{"@type":"Answer","text":"השיטה הטובה ביותר היא דרך היכרויות. אנחנו מחברים אתכם ליועצים מקומיים, לבוגרי התוכנית שכבר פעילים בשוק, ולשותפים אסטרטגיים. בנוסף, כנסים מקצועיים ותוכניות Soft Landing (כמו Landing Pad בטורונטו או Station F בפריז) הם דרך מצוינת לבסס נוכחות."}},{"@type":"Question","name":"מתי כדאי לעשות Pivot?","acceptedAnswer":{"@type":"Answer","text":"כדאי לשקול Pivot כשאחרי 6-12 חודשים של מאמץ אין סימנים ברורים ל-Product Market Fit: לקוחות לא חוזרים, עלות גיוס לקוח גבוהה מדי, או המוצר לא פותר בעיה מספיק כואבת. אנחנו עוזרים לנתח את הנתונים בצורה אובייקטיבית ולזהות אם צריך לשנות כיוון ואיך."}},{"@type":"Question","name":"איך יודעים שיש Product Market Fit?","acceptedAnswer":{"@type":"Answer","text":"סימנים ברורים: לקוחות משתמשים במוצר באופן קבוע (Retention גבוה), ממליצים לאחרים (NPS חיובי), ומוכנים לשלם. המבחן הקלאסי: \"האם 40% מהלקוחות היו מאוכזבים מאוד אם המוצר ייעלם?\". אנחנו עוזרים לכם למדוד ולשפר את הזיקה למוצר."}},{"@type":"Question","name":"איך נבחרים המנטורים?","acceptedAnswer":{"@type":"Answer","text":"המנטורים שלנו הם יזמים מצליחים, מנהלים בכירים, ומומחים בתחומם עם ניסיון רלוונטי לסטארטאפ שלכם. אחרי שמבינים את הצרכים שלכם, אנחנו מציעים 2-3 מנטורים פוטנציאליים לבחירה. המיצוי הוא לפי תחום, שלב, והתאמה אישית."}},{"@type":"Question","name":"מה קורה ב-Demo Day?","acceptedAnswer":{"@type":"Answer","text":"Demo Day הוא אירוע שבו הסטארטאפים מציגים בפני קהל של משקיעים, שותפים פוטנציאליים, ותקשורת. זו הזדמנות להשיג חשיפה, לפתוח שיחות עם משקיעים, וליצור קשרים עסקיים. אנחנו מכינים אתכם עם Pitch coaching ומזמינים את המשקיעים הרלוונטיים."}},{"@type":"Question","name":"מי זכאי למענק מרשות החדשנות?","acceptedAnswer":{"@type":"Answer","text":"סטארטאפים ישראליים שמפתחים טכנולוגיה חדשנית. רשות החדשנות מממנת עד 50% מעלויות המחקר והפיתוח (עד 85% לחברות בפריפריה או מסלולים מיוחדים). נדרש להוכיח חדשנות טכנולוגית ופוטנציאל עסקי. אנחנו עוזרים בהכנת הבקשה."}},{"@type":"Question","name":"כמה זמן לוקח לקבל אישור למענק?","acceptedAnswer":{"@type":"Answer","text":"תהליך אישור מענק רשות החדשנות לוקח בממוצע 3-4 חודשים. לתוכניות אירופאיות (Horizon) - 6-9 חודשים. חשוב להגיש בקשה מוקדם ולתכנן את ה-Cash Flow בהתאם. אנחנו עוזרים להאיץ את התהליך עם בקשות מסודרות."}}]}]}0:{"buildId":"4aaLsfa1CGFoWFQMVKA01","rsc":["$","$1","c",{"children":[[["$","$L2",null,{"id":"biz-services-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$3"}}],"$L4"],["$L5"],"$L6"]}],"loading":null,"isPartial":false}
