lassName":"px-5 pb-5 text-slate-600 leading-relaxed border-t border-slate-100 pt-4","itemScope":true,"itemProp":"acceptedAnswer","itemType":"https://schema.org/Answer","children":["$","p",null,{"itemProp":"text","children":"המנטורים שלנו הם יזמים מצליחים, מנהלים בכירים, ומומחים בתחומם עם ניסיון רלוונטי לסטארטאפ שלכם. אחרי שמבינים את הצרכים שלכם, אנחנו מציעים 2-3 מנטורים פוטנציאליים לבחירה. המיצוי הוא לפי תחום, שלב, והתאמה אישית."}]}]]}],["$","details","1",{"className":"group bg-white border border-slate-100 overflow-hidden","itemScope":true,"itemProp":"mainEntity","itemType":"https://schema.org/Question","children":[["$","summary",null,{"className":"flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors","children":[["$","h4",null,{"className":"text-base font-medium text-slate-900 pl-4","itemProp":"name","children":"מה קורה ב-Demo Day?"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0","aria-hidden":"true","children":[["$","path","qrunsl",{"d":"m6 9 6 6 6-6"}],"$undefined"]}]]}],["$","div",null,{"className":"px-5 pb-5 text-slate-600 leading-relaxed border-t border-slate-100 pt-4","itemScope":true,"itemProp":"acceptedAnswer","itemType":"https://schema.org/Answer","children":["$","p",null,{"itemProp":"text","children":"Demo Day הוא אירוע שבו הסטארטאפים מציגים בפני קהל של משקיעים, שותפים פוטנציאליים, ותקשורת. זו הזדמנות להשיג חשיפה, לפתוח שיחות עם משקיעים, וליצור קשרים עסקיים. אנחנו מכינים אתכם עם Pitch coaching ומזמינים את המשקיעים הרלוונטיים."}]}]]}]]}]]}]
1c:["$","div","grants",{"className":"mb-12 last:mb-0","children":[["$","div",null,{"className":"flex items-center gap-3 mb-6","children":[["$","div",null,{"className":"w-10 h-10 bg-gradient-to-br from-pink-500 to-rose-600 flex items-center justify-center","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-piggy-bank w-5 h-5 text-slate-700","aria-hidden":"true","children":[["$","path","1piglc",{"d":"M11 17h3v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a3.16 3.16 0 0 0 2-2h1a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1h-1a5 5 0 0 0-2-4V3a4 4 0 0 0-3.2 1.6l-.3.4H11a6 6 0 0 0-6 6v1a5 5 0 0 0 2 4v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1z"}],["$","path","1m94wz",{"d":"M16 10h.01"}],["$","path","1env43",{"d":"M2 8v1a2 2 0 0 0 2 2h1"}],"$undefined"]}]}],["$","h3",null,{"className":"text-lg font-semibold text-slate-900","children":"מענקים והטבות"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","details","0",{"className":"group bg-white border border-slate-100 overflow-hidden","itemScope":true,"itemProp":"mainEntity","itemType":"https://schema.org/Question","children":[["$","summary",null,{"className":"flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors","children":[["$","h4",null,{"className":"text-base font-medium text-slate-900 pl-4","itemProp":"name","children":"מי זכאי למענק מרשות החדשנות?"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0","aria-hidden":"true","children":[["$","path","qrunsl",{"d":"m6 9 6 6 6-6"}],"$undefined"]}]]}],["$","div",null,{"className":"px-5 pb-5 text-slate-600 leading-relaxed border-t border-slate-100 pt-4","itemScope":true,"itemProp":"acceptedAnswer","itemType":"https://schema.org/Answer","children":["$","p",null,{"itemProp":"text","children":"סטארטאפים ישראליים שמפתחים טכנולוגיה חדשנית. רשות החדשנות מממנת עד 50% מעלויות המחקר והפיתוח (עד 85% לחברות בפריפריה או מסלולים מיוחדים). נדרש להוכיח חדשנות טכנולוגית ופוטנציאל עסקי. אנחנו עוזרים בהכנת הבקשה."}]}]]}],["$","details","1",{"className":"group bg-white border border-slate-100 overflow-hidden","itemScope":true,"itemProp":"mainEntity","itemType":"https://schema.org/Question","children":[["$","summary",null,{"className":"flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors","children":[["$","h4",null,{"className":"text-base font-medium text-slate-900 pl-4","itemProp":"name","children":"כמה זמן לוקח לקבל אישור למענק?"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0","aria-hidden":"true","children":[["$","path","qrunsl",{"d":"m6 9 6 6 6-6"}],"$undefined"]}]]}],["$","div",null,{"className":"px-5 pb-5 text-slate-600 leading-relaxed border-t border-slate-100 pt-4","itemScope":true,"itemProp":"acceptedAnswer","itemType":"https://schema.org/Answer","children":["$","p",null,{"itemProp":"text","children":"תהליך אישור מענק רשות החדשנות לוקח בממוצע 3-4 חודשים. לתוכניות אירופאיות (Horizon) - 6-9 חודשים. חשוב להגיש בקשה מוקדם ולתכנן את ה-Cash Flow בהתאם. אנחנו עוזרים להאיץ את התהליך עם בקשות מסודרות."}]}]]}]]}]]}]
