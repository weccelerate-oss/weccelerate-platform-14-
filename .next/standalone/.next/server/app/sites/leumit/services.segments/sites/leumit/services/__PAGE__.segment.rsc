g/Answer","children":["$","p",null,{"itemProp":"text","children":"הפיילוט מתחיל בהגדרת פרוטוקול מחקרי יחד עם הצוות הרפואי שלנו. לאחר מכן, אנו בוחרים את המרפאות המתאימות מתוך רשת לאומית, מגייסים מטופלים רלוונטיים, ומלווים את איסוף הדאטה. התהליך כולל אישורי הלסינקי ו-IRB. זמן ממוצע להשקת פיילוט: 2-3 חודשים."}]}]]}],["$","details","1",{"className":"group bg-slate-50 border border-slate-100","itemScope":true,"itemProp":"mainEntity","itemType":"https://schema.org/Question","children":[["$","summary",null,{"className":"flex items-center justify-between p-6 cursor-pointer list-none","children":[["$","h4",null,{"className":"text-lg font-medium text-slate-900 pl-4","itemProp":"name","children":"האם הדאטה שנאסף יכול לשמש להגשה לרגולטור?"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform","aria-hidden":"true","children":[["$","path","qrunsl",{"d":"m6 9 6 6 6-6"}],"$undefined"]}]]}],["$","div",null,{"className":"px-6 pb-6 text-slate-600 leading-relaxed","itemScope":true,"itemProp":"acceptedAnswer","itemType":"https://schema.org/Answer","children":["$","p",null,{"itemProp":"text","children":"בהחלט. הפיילוטים שלנו מתוכננים מראש לעמוד בסטנדרטים רגולטוריים. אנו מקפידים על GCP (Good Clinical Practice) ותיעוד מלא שמאפשר שימוש בדאטה להגשות ל-FDA ו-CE. יש לנו ניסיון בתמיכה במספר הגשות מוצלחות."}]}]]}],["$","details","2",{"className":"group bg-slate-50 border border-slate-100","itemScope":true,"itemProp":"mainEntity","itemType":"https://schema.org/Question","children":[["$","summary",null,{"className":"flex items-center justify-between p-6 cursor-pointer list-none","children":[["$","h4",null,{"className":"text-lg font-medium text-slate-900 pl-4","itemProp":"name","children":"כמה מטופלים אפשר לגייס למחקר?"}],["$","svg",null,{"xmlns"