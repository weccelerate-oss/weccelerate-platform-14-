3:T2d0f,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://leumit.weccelerate.co.il/services","name":"שירותי MedTech - WeCcelerate","description":"שירותי ייעוץ רגולטורי, ניסויים קליניים ואימות דאטה לסטארטאפים רפואיים","inLanguage":"he"},{"@type":"Service","@id":"https://leumit.weccelerate.co.il/services#regulatory","name":"Regulatory Consulting","alternateName":"ייעוץ רגולטורי","description":"ליווי מקצועי בתהליכי רגולציה מורכבים - מהכנת התיק הרגולטורי ועד קבלת האישורים הנדרשים לשיווק המוצר בישראל, אירופה וארה\"ב.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il","parentOrganization":{"@type":"Organization","name":"Leumit Health Services"}},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"MedTech Consulting","hasOfferCatalog":{"@type":"OfferCatalog","name":"ייעוץ רגולטורי","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"הכנת תיק טכני (Technical File)"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ניהול תהליך 510(k) מול ה-FDA"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הסמכת CE Mark לשוק האירופי"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"אישור משרד הבריאות הישראלי"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ייעוץ סיווג מכשיר רפואי"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הכנה לביקורות ואודיטים"},"position":6}]}},{"@type":"Service","@id":"https://leumit.weccelerate.co.il/services#clinical-trials","name":"Clinical Trials Access","alternateName":"גישה לניסויים קליניים","description":"גישה ייחודית לסביבה קלינית אמיתית דרך רשת המרפאות של לאומית. אפשרות לביצוע פיילוטים, איסוף דאטה קליני, וניסויים קליניים מלאים.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il","parentOrganization":{"@type":"Organization","name":"Leumit Health Services"}},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"MedTech Consulting","hasOfferCatalog":{"@type":"OfferCatalog","name":"גישה לניסויים קליניים","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"גישה ל-450+ מרפאות לאומית"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"פיילוטים בסביבה קלינית אמיתית"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"גיוס מטופלים למחקרים"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ניהול IRB ואישורי ועדות הלסינקי"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"איסוף ועיבוד דאטה קליני"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ליווי רופאים ומומחים קליניים"},"position":6}]}},{"@type":"Service","@id":"https://leumit.weccelerate.co.il/services#data-validation","name":"Medical Data Validation","alternateName":"אימות ועיבוד דאטה רפואי","description":"גישה לדאטה רפואי אנונימי ומאובטח לצורכי פיתוח, אימון מודלים, ואימות אלגוריתמים. הדאטה עובר תהליך אנונימיזציה קפדני ועומד בכל תקני האבטחה.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il","parentOrganization":{"@type":"Organization","name":"Leumit Health Services"}},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"MedTech Consulting","hasOfferCatalog":{"@type":"OfferCatalog","name":"אימות ועיבוד דאטה רפואי","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"דאטה אנונימי לפי תקני HIPAA"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"מאגרי תמונות רפואיות"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"רשומות רפואיות מובנות"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"דאטה לאימון AI/ML"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"סביבת Sandbox מאובטחת"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"API לגישה לדאטה בזמן אמת"},"position":6}]}},{"@type":"Service","@id":"https://leumit.weccelerate.co.il/services#compliance","name":"Compliance & Security","alternateName":"ציות ואבטחת מידע","description":"סיוע בהטמעת תהליכי ציות לרגולציות פרטיות ואבטחת מידע. הכנה להסמכות ובניית מערכות ניהול אבטחת מידע.","provider":{"@type":"Organization","name":"WeCcelerate","url":"https://weccelerate.co.il","parentOrganization":{"@type":"Organization","name":"Leumit Health Services"}},"areaServed":{"@type":"Country","name":"Israel"},"serviceType":"MedTech Consulting","hasOfferCatalog":{"@type":"OfferCatalog","name":"ציות ואבטחת מידע","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"הטמעת HIPAA compliance"},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"התאמה ל-GDPR"},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הכנה להסמכת ISO 27001"},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"בניית מדיניות אבטחת מידע"},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"הדרכות עובדים"},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"ביקורות וסקרי סיכונים"},"position":6}]}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"כמה זמן לוקח לקבל אישור FDA?","acceptedAnswer":{"@type":"Answer","text":"תהליך 510(k) אורך בממוצע 3-6 חודשים מהגשת התיק המלא. אנו מסייעים בהכנת התיק בצורה מקיפה שמפחיתה את הסיכוי לבקשות הבהרה ומקצרת את הזמן לאישור. לפרויקטים מורכבים יותר (PMA), התהליך יכול להימשך 12-18 חודשים."}},{"@type":"Question","name":"האם אתם עוזרים גם עם אישור CE באירופה?","acceptedAnswer":{"@type":"Answer","text":"כן, אנו מספקים ליווי מלא לקבלת סימון CE תחת רגולציית MDR החדשה. זה כולל הכנת תיק טכני, ניהול קשר עם Notified Body, והכנה לביקורות. יש לנו ניסיון עם חברות מובילות באירופה."}},{"@type":"Question","name":"מה ההבדל בין סיווג Class I ל-Class II?","acceptedAnswer":{"@type":"Answer","text":"מכשירים מסוג Class I נחשבים לסיכון נמוך ולרוב פטורים מהגשת 510(k). מכשירים מסוג Class II הם בסיכון בינוני ודורשים הגשת 510(k) להוכחת שקילות מהותית למוצר קיים. אנו עוזרים בהגדרת הסיווג הנכון ובבניית האסטרטגיה הרגולטורית המתאימה."}},{"@type":"Question","name":"איך מתבצע פיילוט קליני דרככם?","acceptedAnswer":{"@type":"Answer","text":"הפיילוט מתחיל בהגדרת פרוטוקול מחקרי יחד עם הצוות הרפואי שלנו. לאחר מכן, אנו בוחרים את המרפאות המתאימות מתוך רשת לאומית, מגייסים מטופלים רלוונטיים, ומלווים את איסוף הדאטה. התהליך כולל אישורי הלסינקי ו-IRB. זמן ממוצע להשקת פיילוט: 2-3 חודשים."}},{"@type":"Question","name":"האם הדאטה שנאסף יכול לשמש להגשה לרגולטור?","acceptedAnswer":{"@type":"Answer","text":"בהחלט. הפיילוטים שלנו מתוכננים מראש לעמוד בסטנדרטים רגולטוריים. אנו מקפידים על GCP (Good Clinical Practice) ותיעוד מלא שמאפשר שימוש בדאטה להגשות ל-FDA ו-CE. יש לנו ניסיון בתמיכה במספר הגשות מוצלחות."}},{"@type":"Question","name":"כמה מטופלים אפשר לגייס למחקר?","acceptedAnswer":{"@type":"Answer","text":"עם גישה ל-2.3 מיליון מבוטחי לאומית, אנו יכולים לגייס מאות ואף אלפי מטופלים למחקרים גדולים. לפיילוטים קטנים, גיוס של 50-200 מטופלים אפשרי תוך שבועות. הגיוס מבוצע בהתאם לקריטריונים שלכם ובאישור ועדת הלסינקי."}},{"@type":"Question","name":"איך הדאטה מאונונם ומאובטח?","acceptedAnswer":{"@type":"Answer","text":"הדאטה עובר תהליך אנונימיזציה מתקדם שמסיר כל מידע מזהה (PII) בהתאם לתקני HIPAA ו-GDPR. הגישה לדאטה מתבצעת רק דרך סביבת Sandbox מאובטחת, ללא אפשרות להורדת דאטה גולמי. כל הפעילות מנוטרת ומתועדת."}},{"@type":"Question","name":"האם אפשר להשתמש בדאטה לאימון מודלי AI?","acceptedAnswer":{"@type":"Answer","text":"כן, הדאטה שלנו אידיאלי לאימון מודלים. יש לנו מאגרים של תמונות רפואיות (רנטגן, MRI, CT), רשומות טקסטואליות, ונתוני מעבדה. ניתן לעבוד על הדאטה בסביבה שלנו עם GPU חזק, או לקבל דאטה סינתטי מבוסס על הדאטה האמיתי."}},{"@type":"Question","name":"מה סוגי הדאטה הזמינים?","acceptedAnswer":{"@type":"Answer","text":"זמינים: רשומות רפואיות אלקטרוניות (EMR), תמונות רפואיות (רדיולוגיה, פתולוגיה, דרמטולוגיה), נתוני מעבדה, מרשמים ותרופות, ונתוני התנהגות בריאותית. ניתן לבקש חיתוכים ספציפיים לפי גיל, מגדר, אבחנות, ועוד."}},{"@type":"Question","name":"האם חובה לעמוד ב-HIPAA?","acceptedAnswer":{"@type":"Answer","text":"אם אתם עובדים עם דאטה רפואי של מטופלים אמריקאים או שואפים לפעול בשוק האמריקאי - כן, HIPAA הוא חובה. גם אם אתם פועלים רק בישראל, עמידה בסטנדרטים של HIPAA מוסיפה אמינות ומכינה אתכם להתרחבות עתידית."}},{"@type":"Question","name":"מה הקשר בין ISO 27001 לרגולציה רפואית?","acceptedAnswer":{"@type":"Answer","text":"ISO 27001 הוא תקן בינלאומי לניהול אבטחת מידע. הוא לא ספציפי לרפואה, אבל הוא נדרש לעתים קרובות על ידי בתי חולים, קופות חולים, ורגולטורים כתנאי לעבודה עם דאטה רפואי. ההסמכה מראה שיש לכם מערכת ניהול אבטחה בוגרת."}}]}]}0:{"buildId":"4aaLsfa1CGFoWFQMVKA01","rsc":["$","$1","c",{"children":[[["$","$L2",null,{"id":"medtech-services-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$3"}}],"$L4"],null,"$L5"]}],"loading":null,"isPartial":false}
