1f:["$","div",null,{"className":"px-6 pb-6 text-slate-600 leading-relaxed","itemScope":true,"itemProp":"acceptedAnswer","itemType":"https://schema.org/Answer","children":["$","p",null,{"itemProp":"text","children":"מכשירים מסוג Class I נחשבים לסיכון נמוך ולרוב פטורים מהגשת 510(k). מכשירים מסוג Class II הם בסיכון בינוני ודורשים הגשת 510(k) להוכחת שקילות מהותית למוצר קיים. אנו עוזרים בהגדרת הסיווג הנכון ובבניית האסטרטגיה הרגולטורית המתאימה."}]}]
