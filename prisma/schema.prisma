// =============================================================================
// PRISMA SCHEMA - WeCcelerate Platform
// =============================================================================
// Database: PostgreSQL
// ORM: Prisma 7
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN           // Platform administrators
  ENTREPRENEUR    // Startup founders/business owners
  MENTOR          // Mentors and advisors
  INVESTOR        // Investors with view access
  PARTNER         // External partners (e.g., Leumit)
}

enum ProjectStatus {
  DRAFT                // Initial draft, not submitted
  CHARACTERIZATION     // שלב אפיון - Project characterization
  MARKET_RESEARCH      // מחקר שוק - Market research phase
  BUSINESS_MODEL       // מודל עסקי - Business model development
  DEVELOPMENT          // פיתוח - Product/service development
  FUNDING_PREP         // הכנה לגיוס - Preparing for fundraising
  ACTIVE_FUNDING       // גיוס פעיל - Actively fundraising
  POST_FUNDING         // לאחר גיוס - Post-funding growth
  SCALING              // צמיחה - Scaling phase
  GRADUATED            // בוגר - Graduated from program
  ON_HOLD              // מושהה - Project on hold
  CANCELLED            // בוטל - Project cancelled
}

enum UrgencyLevel {
  NORMAL
  IMPORTANT
  URGENT
  BREAKING
}

enum EventLocationType {
  PHYSICAL
  VIRTUAL
  HYBRID
}

enum EventStatus {
  DRAFT
  UPCOMING
  ONGOING
  PAST
  CANCELLED
}

enum VideoCategory {
  INTERVIEW
  SUMMARY
  WEBINAR
  TUTORIAL
  TESTIMONIAL
  HIGHLIGHT
  PODCAST
  REELS
  TV_INTERVIEW
}

enum FileType {
  DOCUMENT       // PDF, DOC, etc.
  SPREADSHEET    // XLS, CSV
  PRESENTATION   // PPT, KEY
  IMAGE          // PNG, JPG, etc.
  VIDEO          // MP4, MOV
  OTHER
}

enum LessonStatus {
  DRAFT       // Hidden from entrepreneurs — work in progress
  PUBLISHED   // Live in the Learning Center
}

// =============================================================================
// USER & AUTHENTICATION
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Hashed password (nullable for OAuth)
  name          String
  phone         String?
  avatar        String?   // Avatar URL
  image         String?   // NextAuth standard field
  role          UserRole  @default(ENTREPRENEUR)
  isActive      Boolean   @default(true)

  // Profile fields
  company       String?   // Company/startup name
  position      String?   // Job title
  bio           String?   @db.Text
  linkedinUrl   String?
  websiteUrl    String?

  // Preferences
  language      String    @default("he") // he, en
  timezone      String    @default("Asia/Jerusalem")

  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  uploadedFiles File[]    @relation("UploadedBy")
  notifications Notification[]
  activities    ActivityLog[]
  lessonProgress UserLessonProgress[]
  quizAttempts  QuizAttempt[]

  // Onboarding / auto-provisioning
  // True for accounts created via the onboarding webhook with a temp password.
  // After first successful password change we flip this to false.
  mustChangePassword Boolean  @default(false)
  // Raw intake-form payload kept verbatim so the admin can see what the
  // entrepreneur actually filled in. JSON shape varies by source form.
  intakeFormData     Json?
  // Marks accounts NOT created manually by an admin.
  provisionedAt      DateTime?
  // Where the account came from: 'google_form' | 'zapier' | 'admin' | 'manual'
  provisionedSource  String?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  @@index([role, isActive]) // Admin: list entrepreneurs, mentors
  @@index([email])          // Auth: login lookup (covered by unique but explicit)
  @@map("users")
}

// NextAuth.js Account model (for OAuth providers)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// NextAuth.js Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// NextAuth.js VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// ENTREPRENEUR PORTAL - PROJECTS
// =============================================================================

model Project {
  id            String        @id @default(cuid())
  
  // Basic info
  name          String
  description   String?       @db.Text
  industry      String?       // Industry/sector
  website       String?
  
  // CRM Integration
  pipedriveId   String?       @unique // Pipedrive Deal ID
  hubspotId     String?       // HubSpot Deal ID (future)
  
  // Status & Pipeline
  status        ProjectStatus @default(DRAFT)
  stage         Int           @default(1) // Numeric stage (1-10)
  
  // Timeline & Milestones (stored as JSON for flexibility)
  timeline      Json?         // { stages: [{ name, startDate, endDate, status }] }
  milestones    Json?         // { items: [{ title, dueDate, completed }] }
  
  // Funding info
  targetFunding Decimal?      @db.Decimal(15, 2) // Target funding amount
  fundingRaised Decimal?      @db.Decimal(15, 2) // Amount raised so far
  fundingCurrency String      @default("USD")
  
  // Team info
  teamSize      Int?
  foundingDate  DateTime?
  
  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  files         File[]
  notes         ProjectNote[]
  activities    ActivityLog[]
  
  // Metadata
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([userId])
  @@index([pipedriveId])
  @@index([status])
  @@index([userId, isArchived]) // Dashboard: find user's active project
  @@index([isArchived, updatedAt]) // Admin: list projects sorted by update
  @@map("projects")
}

model ProjectNote {
  id          String   @id @default(cuid())
  content     String   @db.Text
  isPrivate   Boolean  @default(false) // Admin-only notes
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  
  authorName  String?  // For admin notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@map("project_notes")
}

// =============================================================================
// FILE MANAGEMENT - Google Cloud Storage
// =============================================================================

model File {
  id            String    @id @default(cuid())
  
  // File info
  name          String    // Original filename
  displayName   String?   // User-friendly name
  description   String?
  
  // Google Cloud Storage
  url           String    // Public or signed URL from GCS
  gcsPath       String?   // Full GCS path (gs://bucket/path)
  bucket        String?   // GCS bucket name
  
  // Signed URL support
  signedUrl     String?   // Pre-signed URL for private access
  signedUrlExpiry DateTime? // When the signed URL expires
  isPrivate     Boolean   @default(true) // If true, requires signed URL
  
  // Metadata
  type          FileType  @default(OTHER)
  mimeType      String?   // MIME type
  size          Int?      // File size in bytes
  checksum      String?   // MD5 hash for integrity
  
  // Relations
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String?
  
  uploadedBy    User?     @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById  String?
  
  // Timestamps
  uploadedAt    DateTime  @default(now())
  
  @@index([projectId])
  @@index([type])
  @@index([uploadedById])
  @@map("files")
}

// =============================================================================
// DYNAMIC CONTENT - NEWS TICKER
// =============================================================================

model NewsUpdate {
  id            String       @id @default(cuid())
  
  // Content
  title         String
  titleEn       String?      // English version
  excerpt       String?      @db.Text
  link          String?      // Optional link to full article
  imageUrl      String?      // Cover image

  // Display settings
  urgencyLevel  UrgencyLevel @default(NORMAL)
  isActive      Boolean      @default(true)
  isPinned      Boolean      @default(false)
  
  // Scheduling
  publishAt     DateTime     @default(now())
  expireAt      DateTime?    // Auto-expire
  
  // Metadata
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@index([isActive, publishAt])
  @@index([urgencyLevel])
  @@map("news_updates")
}

// =============================================================================
// DYNAMIC CONTENT - EVENTS
// =============================================================================

model Event {
  id               String           @id @default(cuid())
  
  // Basic info
  name             String
  nameEn           String?          // English version
  slug             String           @unique // URL-friendly slug
  description      String?          @db.Text
  descriptionEn    String?          @db.Text
  
  // Date & Time
  date             DateTime
  time             String           // Start time (e.g., "18:00")
  endTime          String?          // End time
  timezone         String           @default("Asia/Jerusalem")
  
  // Location
  locationType     EventLocationType @default(PHYSICAL)
  address          String?
  city             String?
  virtualLink      String?          // Zoom/Meet link
  locationDetails  String?          // Additional instructions
  
  // Registration
  registrationLink String?
  registrationRequired Boolean      @default(true)
  capacity         Int?
  registeredCount  Int              @default(0)
  
  // Pricing
  price            Decimal?         @db.Decimal(10, 2)
  currency         String           @default("ILS")
  isFree           Boolean          @default(true)
  
  // Media
  imageUrl         String?
  thumbnailUrl     String?
  
  // Categorization
  category         String?          // Event type/category
  tags             String[]         // Array of tags
  
  // Host/Speaker
  host             String?
  hostBio          String?          @db.Text
  
  // Status & Display
  status           EventStatus      @default(DRAFT)
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  displayOrder     Int              @default(0) // Lower = shown first; 0 = auto (sort by date)

  // Timestamps
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, isActive, date])
  @@index([date])
  @@index([displayOrder])
  @@map("events")
}

// =============================================================================
// DYNAMIC CONTENT - VIDEOS
// =============================================================================

model Video {
  id            String        @id @default(cuid())
  
  // Basic info
  title         String
  titleEn       String?
  slug          String        @unique
  description   String?       @db.Text
  descriptionEn String?       @db.Text
  
  // Video source
  youtubeUrl    String?       // YouTube video URL or ID
  youtubeVideoId String?      @unique // YouTube video ID for dedup (e.g. "npcROfJT5Hg")
  vimeoUrl      String?       // Vimeo URL
  videoUrl      String?       // Direct video URL
  embedUrl      String?       // Pre-formatted embed URL
  
  // Media
  thumbnail     String?       // Thumbnail image URL
  duration      Int?          // Duration in seconds
  
  // Categorization
  category      VideoCategory @default(INTERVIEW)
  tags          String[]
  
  // Speaker/Guest
  speaker       String?
  speakerTitle  String?
  speakerImage  String?
  
  // Stats
  views         Int           @default(0)
  
  // Display settings
  isActive      Boolean       @default(true)
  isFeatured    Boolean       @default(false)
  publishAt     DateTime      @default(now())
  
  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([category, isActive])
  @@index([publishAt])
  @@map("videos")
}

// =============================================================================
// DYNAMIC CONTENT - SUCCESS STORIES
// =============================================================================

model SuccessStory {
  id               String   @id @default(cuid())
  
  // Company info
  companyName      String
  logoUrl          String?
  industry         String?
  website          String?
  
  // Testimonial
  quote            String   @db.Text
  quoteEn          String?  @db.Text
  
  // Person giving testimonial
  personName       String?
  personRole       String?
  personImage      String?
  
  // Results/Metrics
  metrics          Json?    // { items: [{ label, value }] }
  
  // Story details
  slug             String   @unique
  fullStory        String?  @db.Text // Full case study
  fullStoryEn      String?  @db.Text
  projectLink      String?  // Link to case study page
  
  // Collaboration
  collaborationDate String? // Year or date of collaboration
  programName       String? // Which program they were in
  
  // Display settings
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  displayOrder     Int      @default(0)
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([isActive, isFeatured])
  @@map("success_stories")
}

// =============================================================================
// NOTIFICATIONS & ACTIVITY
// =============================================================================

model Notification {
  id          String   @id @default(cuid())
  
  // Content
  title       String
  message     String   @db.Text
  link        String?  // Action link
  type        String   // info, success, warning, error
  
  // Target
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  
  // Status
  isRead      Boolean  @default(false)
  readAt      DateTime?
  
  // Timestamps
  createdAt   DateTime @default(now())
  
  @@index([userId, isRead])
  @@index([userId, createdAt]) // Portal: fetch latest notifications
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(cuid())
  
  // Action details
  action      String   // e.g., "project.created", "file.uploaded"
  description String?
  metadata    Json?    // Additional context
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  
  // Context
  ipAddress   String?
  userAgent   String?
  
  // Timestamp
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([projectId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// =============================================================================
// LEARNING CENTER - COURSES & PROGRESS
// =============================================================================

model CourseCategory {
  id            String         @id @default(cuid())

  name          String         // e.g., "מושגים פיננסיים"
  slug          String         @unique
  description   String?        @db.Text
  icon          String?        // Icon name (lucide)
  color         String?        // Tailwind color (e.g., "blue", "emerald")
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)

  subcategories CourseSubcategory[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isActive, displayOrder])
  @@map("course_categories")
}

model CourseSubcategory {
  id            String         @id @default(cuid())

  name          String         // e.g., "דוחות כספיים"
  slug          String         @unique
  description   String?        @db.Text
  displayOrder  Int            @default(0)

  category      CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    String

  lessons       CourseLesson[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId, displayOrder])
  @@map("course_subcategories")
}

model CourseLesson {
  id            String         @id @default(cuid())

  title         String         // e.g., "דוח P&L"
  slug          String         @unique
  description   String?        @db.Text
  // Rich body shown under the video player (notes, transcript, links).
  content       String?        @db.Text
  // YouTube URL is now optional so a lesson can be saved as a draft before
  // the video is ready. The portal only renders PUBLISHED lessons.
  youtubeUrl    String?        // YouTube URL
  youtubeId     String?        // Extracted YouTube ID
  duration      Int?           // Duration in seconds
  displayOrder  Int            @default(0)
  // Legacy flag kept for backwards-compat. `status` is the real publish gate.
  isActive      Boolean        @default(true)
  status        LessonStatus   @default(DRAFT)
  publishedAt   DateTime?

  subcategory   CourseSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  subcategoryId String

  progress      UserLessonProgress[]
  attachments   LessonAttachment[]
  quiz          Quiz?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([subcategoryId, displayOrder])
  @@index([status])
  @@map("course_lessons")
}

// Downloadable resources attached to a lesson (PDF, slides, templates).
// Uploaded to Supabase Storage via /api/admin/learning/attachments — reuses
// the same storage mechanism as the portal document vault.
model LessonAttachment {
  id           String       @id @default(cuid())

  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String

  name         String       // Display name
  url          String       // Public / signed Supabase URL
  mimeType     String?
  size         Int?         // Bytes
  displayOrder Int          @default(0)

  createdAt    DateTime     @default(now())

  @@index([lessonId, displayOrder])
  @@map("lesson_attachments")
}

// Optional end-of-lesson quiz (one per lesson).
model Quiz {
  id          String         @id @default(cuid())

  lesson      CourseLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String         @unique

  title       String?
  passScore   Int            @default(70) // % required to pass

  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("quizzes")
}

model QuizQuestion {
  id           String   @id @default(cuid())

  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId       String

  prompt       String   @db.Text
  options      Json     // [{ id: string, text: string }]
  correctId    String   // id of the correct option
  displayOrder Int      @default(0)

  @@index([quizId, displayOrder])
  @@map("quiz_questions")
}

model QuizAttempt {
  id        String   @id @default(cuid())

  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  answers   Json     // { [questionId]: chosenOptionId }
  score     Int      // %
  passed    Boolean

  createdAt DateTime @default(now())

  @@index([quizId, userId])
  @@index([userId])
  @@map("quiz_attempts")
}

model UserLessonProgress {
  id            String       @id @default(cuid())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  lesson        CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId      String

  completed     Boolean      @default(false)
  completedAt   DateTime?

  // Resume memory: where the user paused, how long the video is, and when
  // they last touched it. Powers the "המשך מהמקום שעצרת" card and the
  // partial progress bar on each lesson row.
  positionSec   Int          @default(0)
  durationSec   Int?
  lastWatchedAt DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([userId, lastWatchedAt])
  @@map("user_lesson_progress")
}

// =============================================================================
// SITE SETTINGS & CONFIGURATION
// =============================================================================

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json     // Flexible JSON value
  description String?

  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

// =============================================================================
// AI BOT VISIT TRACKING (GEO/AEO ANALYTICS)
// =============================================================================
//
// Every hit from a known AI crawler (GPTBot, ClaudeBot, PerplexityBot, etc.)
// is logged here via the /api/bot/log endpoint, which is called
// fire-and-forget from middleware.ts. The admin page
// `/admin/bot-analytics` aggregates this to measure GEO effectiveness:
//
//   - Which AI engines are scanning us?
//   - Which pages do they visit most?
//   - Is activity growing over time (the success signal for GEO/AEO)?
//
// Retention: up to the caller to prune. In production a cron job should
// delete rows older than 90 days to keep the table compact.
//
model BotVisit {
  id          String   @id @default(cuid())

  // What KIND of AI-related visit is this:
  //   "crawl"    — an LLM bot fetched the page itself (citation read-through).
  //                Examples: ChatGPT-User came to read /, PerplexityBot indexed.
  //   "referral" — a real human visited via a link inside an LLM answer.
  //                Detected by Referer header from chatgpt.com / perplexity.ai
  //                / claude.ai / gemini.google.com / copilot.microsoft.com.
  // The user-facing dashboard shows them in separate sections so you can
  // tell "we got cited" (crawl) apart from "user clicked through" (referral).
  kind        String   @default("crawl")

  // For crawl: the bot's user-agent name (GPTBot, ClaudeBot, PerplexityBot…).
  // For referral: a normalized source label (ChatGPT, Perplexity, Claude…).
  // Source of truth for crawl: AI_BOT_SIGNATURES in middleware.ts.
  bot         String

  // Request context
  path        String   // Pathname visited, e.g. "/guides/rayon-le-startup"
  host        String   // Host header, e.g. "weccelerate.co.il"
  method      String   @default("GET")

  // Optional enrichment fields
  referer     String?  // Referer header if present (always set for referrals)
  country     String?  // Two-letter country code from Vercel geo (if available)
  region      String?  // Country subdivision (Vercel: x-vercel-ip-country-region)
  city        String?  // City name from Vercel geo (Tel Aviv, Jerusalem, ...)
  userAgent   String?  // Full UA string for debugging signature drift

  timestamp   DateTime @default(now())

  @@index([bot])
  @@index([kind])
  @@index([timestamp])
  @@index([bot, timestamp])
  @@index([kind, timestamp])
  @@index([path])
  @@map("bot_visits")
}

// =============================================================================
// GEO PROBE — active LLM citation monitoring
// =============================================================================
// While BotVisit is PASSIVE (we listen for AI bot visits), GeoProbe is ACTIVE:
// once a day a cron asks ChatGPT / Perplexity / etc. real questions and stores
// what they answered, whether WeCcelerate was mentioned, and whether the
// canonical URL was cited. The dashboard graphs the citation rate over time.
//
// One row per (provider, query, run). A daily cron creates ~10–20 rows/day.

model GeoProbe {
  id          String   @id @default(cuid())

  // Which LLM answered. Examples: 'perplexity-sonar', 'openai-gpt4o-search',
  // 'anthropic-claude-3-5-sonnet'. Includes model version so trend graphs
  // don't lie when the underlying model changes.
  provider    String

  // The exact prompt we asked. Kept verbatim so we can compare answers across
  // runs.
  query       String   @db.Text

  // Optional grouping label, e.g. 'brand-he', 'generic-en', 'service'.
  category    String?

  // The full answer text returned by the LLM (truncated to 8 KB).
  response    String   @db.Text

  // URLs the LLM cited (parsed from response or returned via API metadata).
  citedUrls   String[] @default([])

  // Detection results computed at write time so dashboard queries stay fast.
  mentioned   Boolean  @default(false)  // brand name appears in answer
  cited       Boolean  @default(false)  // weccelerate.co.il in citedUrls
  position    Int?                       // first-mention position (1 = first cited source)

  // Run metadata
  durationMs  Int?     // round-trip ms
  error       String?  // populated if the probe failed (rate limit, network…)
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([provider, timestamp])
  @@index([cited, timestamp])
  @@index([query])
  @@map("geo_probes")
}

// =============================================================================
// CONTENT AGENT — autonomous writer pipeline
// =============================================================================
// ContentGap = a topic the LLMs aren't citing us on (detected by analyzing
// geo_probes results). The writer agent picks the highest-priority open gap
// each day and generates a guide to address it.

model ContentGap {
  id            String   @id @default(cuid())

  // Source of the gap signal
  source        String   // 'probe-no-cite' | 'probe-low-rate' | 'manual'

  // The query/topic that exposed the gap
  query         String   @db.Text
  category      String?  // mirrors ProbeQuery.category

  // Severity 0-100, used as priority when picking the next gap to address
  severity      Int      @default(50)

  // Competitors who ARE cited for this query (so the writer can study them)
  competitors   String[] @default([])

  // Lifecycle
  status        String   @default("open") // open | in_progress | published | rejected
  rejectReason  String?
  generatedGuideId String?  @unique
  detectedAt    DateTime @default(now())
  resolvedAt    DateTime?

  @@index([status, severity])
  @@index([detectedAt])
  @@map("content_gaps")
}

// GeneratedGuide = a guide written by the writer agent. Lives separately from
// the static lib/seo/guides-catalog.ts (manually-authored guides) so it has
// a full audit trail (which model, which prompts, fact-check results).

model GeneratedGuide {
  id            String   @id @default(cuid())

  // The /guides/[slug] URL. Must be unique site-wide.
  slug          String   @unique

  // SEO surfaces
  titleHe       String
  titleEn       String?
  metaDescription String  @db.Text
  category      String

  // Body — markdown with embedded JSON-LD-friendly structure
  contentHe     String   @db.Text
  contentEn     String?  @db.Text

  // Visuals
  featuredImageUrl String?
  socialImageUrl   String?

  // Generation provenance
  modelChain    String[] @default([])  // ['perplexity-sonar', 'claude-opus-4-7', ...]
  citedSources  String[] @default([])  // URLs the writer used as research
  internalLinks String[] @default([])  // /guides/X paths linked from this guide

  // Quality metrics
  factCheckScore Int?    // 0-100 from fact-checker stage
  seoScore       Int?    // 0-100 from SEO linter
  wordCount      Int?

  // Lifecycle
  status        String   @default("draft") // draft | published | retracted
  publishedAt   DateTime?
  retractedAt   DateTime?
  retractReason String?

  // Performance (filled in by daily cron after publish)
  firstCitedAt  DateTime?  // when first GEO Probe shows we're cited for original gap
  citationCount Int       @default(0)
  botVisits     Int       @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@map("generated_guides")
}

// =============================================================================
// WRITING JOB — durable state machine for the split, chunked writer pipeline
// =============================================================================
// The writer cannot complete inside a single serverless invocation: on Vercel
// Hobby the 60s function limit kills the process mid-write, so a guide was NEVER
// published. WritingJob persists intermediate artifacts between invocations so
// each stage runs in its own fresh 60s budget, chained via Next.js `after()`.
// One row per article attempt.
//
// The article is written with Opus (kept for quality), which would take
// 100-200s to emit a full guide in one call — far past 60s. So the `sections`
// stage writes the article ONE section per invocation, looping until done.
//
// stage advances: research -> plan -> sections (loops) -> finalize -> done
//                                                                  (or -> failed).
// A daily reaper (resumeStalledWritingJobs) re-dispatches jobs left mid-stage.

model WritingJob {
  id            String   @id @default(cuid())

  // The gap this job is resolving (claimed in_progress on the ContentGap row).
  gapId         String
  query         String   @db.Text
  category      String?
  competitors   String[] @default([])

  // State machine
  stage         String   @default("research") // research | plan | sections | finalize | done | failed
  attempts      Int      @default(0)           // dispatch attempts for the CURRENT stage/section (retry cap)
  error         String?  @db.Text              // last failure reason, if any

  // Stage: research — Sonnet + web_search
  researchSummary String? @db.Text
  sources         String[] @default([])

  // Stage: plan — Opus, one call: title/meta/intro + the section blueprint
  titleHe         String?
  titleEn         String?
  metaDescription String?
  intro           String?  @db.Text
  sectionPlan     Json?    // [{ heading: string, brief: string }]

  // Stage: sections — Opus, ONE section per invocation (chunked to fit 60s)
  sectionIndex    Int      @default(0)          // next section to write
  sectionContents Json     @default("[]")       // string[] of rendered section markdown, in order

  // Stage: finalize — assembled body + published result
  contentHe        String?  @db.Text
  generatedGuideId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([stage, updatedAt])
  @@index([gapId])
  @@map("writing_jobs")
}

// =============================================================================
// AGENT DECISION LOG — explainability of every autonomous action
// =============================================================================
// Every meaningful decision the agent makes is logged here so the operator
// can read /admin/daily-report and understand *why* the agent did what it
// did, not just *what* it did. Examples:
//   - "Picked gap 'מהי ועדת הלסינקי' because severity=100, competitors=[ynet, gov.il]"
//   - "Skipped publish: fact-check score 45 below threshold 60"
//   - "Adjusted strategy: gap X stayed unresolved 14 days post-publish — refresh queued"

model AgentDecision {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())

  // Which agent made the decision
  agent        String   // 'gap-analyzer' | 'content-writer' | 'self-improver' | 'competitor-watch' | 'system'

  // What kind of decision
  action       String   // 'picked-gap' | 'wrote-guide' | 'skipped-publish' | 'queued-refresh' | etc.

  // Free-form Hebrew explanation aimed at the operator
  reasoning    String   @db.Text

  // Structured payload — what entities were involved
  payload      Json     @default("{}")

  // Outcome tags
  success      Boolean  @default(true)
  durationMs   Int?

  @@index([timestamp])
  @@index([agent, timestamp])
  @@index([action, timestamp])
  @@map("agent_decisions")
}

// =============================================================================
// COMPETITOR INTEL — who else gets cited and what they publish
// =============================================================================

model CompetitorMention {
  id            String   @id @default(cuid())
  detectedAt    DateTime @default(now())

  // Domain that got cited (e.g. 'pitango.com', 'ourcrowd.com', 'janvest.com')
  competitorHost String

  // Which probe query they were cited in
  query         String

  // Which LLM cited them
  provider      String

  // The full URL the LLM cited (so we can crawl it later)
  citedUrl      String

  @@index([competitorHost, detectedAt])
  @@index([detectedAt])
  @@map("competitor_mentions")
}

// =============================================================================
// SPAM BLOCKLIST — emails/IPs the admin has manually marked as spam
// =============================================================================
// Populated by /admin/leads when an operator clicks 'סמן כספאם' on a lead.
// Any future submission matching an entry here is hard-blocked at the top
// of routeLeadThroughFilter — never makes it through scoring.

model SpamBlocklist {
  id          String   @id @default(cuid())
  // EXACTLY ONE of these is set per row.
  email       String?  // lowercase
  ipHash      String?  // sha256 of the source IP (privacy)
  // Free-text reason the admin gave when marking.
  reason      String?
  // Who marked it.
  addedByUserId String?
  addedAt     DateTime @default(now())
  // Auto-blocks expire; manual blocks don't.
  expiresAt   DateTime?

  @@unique([email])
  @@unique([ipHash])
  @@index([addedAt])
  @@map("spam_blocklist")
}
